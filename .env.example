# LLM endpoint (OpenAI-compatible). Defaults to Sluice; any OpenAI-compatible endpoint works,
# e.g. QUARRY_LLM_BASE_URL=https://api.groq.com/openai/v1 with a Groq key and model openai/gpt-oss-120b.
QUARRY_LLM_BASE_URL=https://sluice-orcin.vercel.app/v1
QUARRY_LLM_API_KEY=
QUARRY_LLM_MODEL=sluice/smart

# Optional: shared rate limits for the public demo (in-memory without these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QUARRY_MAX_REPAIRS=2
QUARRY_QUERY_TIMEOUT_S=8
QUARRY_ASKS_PER_HOUR=20
QUARRY_ASKS_PER_DAY=300
