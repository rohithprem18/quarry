{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "data/dbs/{formula_1,california_schools,thrombosis_prediction,toxicology,student_club,superhero}/**" }
  }
}
